# 复制本文件为 .env 后填写真实值；.env 不要提交、不要外传
# 代理：v2rayN 默认 http://127.0.0.1:10808，Clash 默认 http://127.0.0.1:7890；不用代理就留空
HTTPS_PROXY=

# 仪表盘端口：被其他程序占用时改这里（启动脚本会先检查，不会关掉别的程序）
DASH_BACKEND_PORT=8105
DASH_FRONTEND_PORT=5185

# 测试网 / 模拟盘密钥：只开读取+交易，永不开提币
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=[REDACTED_PASSWORD]
OKX_DEMO_SECRET=[REDACTED_PASSWORD]
